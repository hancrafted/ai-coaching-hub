---
// The "S2.1 · Motivation" eyebrow plus heading, repeated across all 18 beats
// (32 hits on the `tracking-[0.3em]`/`[0.25em]` eyebrow pattern in the harvest).
interface Props {
  code: string;
  section: string;
  title?: string;
  lede?: string;
  size?: 'md' | 'hero';
}
const { code, section, title, lede, size = 'md' } = Astro.props;
---

<div class="bh" data-size={size}>
  <p class="bh__eyebrow">{code} · {section}</p>
  {size === 'hero' ? <h1 class="bh__title">{title}</h1> : title && <h2 class="bh__title">{title}</h2>}
  {lede && <p class="bh__lede">{lede}</p>}
  <slot />
</div>

<style>
  .bh__eyebrow {
    font-family: var(--k-font-mono);
    font-size: var(--k-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: color-mix(in oklab, var(--k-accent-high) 80%, transparent);
    margin: 0 0 1rem;
  }
  .bh__title {
    font-size: clamp(1.75rem, 4vw, var(--k-text-4xl));
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .bh[data-size='hero'] .bh__eyebrow {
    margin-block-end: 1.5rem;
  }
  .bh[data-size='hero'] .bh__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 1.02;
  }
  .bh__lede {
    margin-block-start: 1.25rem;
    font-size: var(--k-text-lg);
    line-height: 1.65;
    color: var(--k-fg-muted);
    max-width: 60ch;
  }
  .bh[data-size='hero'] .bh__lede {
    margin-block-start: 2.5rem;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 300;
  }
</style>
