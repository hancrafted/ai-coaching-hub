---
// THE HUB, ON THE STARLIGHT TREE.
//
// Issue #4 claimed: "no built-in marketing top-nav — handled by component
// overrides", with `src/pages/*.astro` as a LAST-RESORT escape hatch. The plan
// for this prototype requires trying the sanctioned route first and recording
// which one we actually land on.
//
// ATTEMPT 1 (what you are reading): `<StarlightPage template="splash">`. Verdict
// recorded on /findings — in short, `splash` gets us a chrome-free canvas and
// Starlight's header/search/theme-toggle stay intact, so NO `Header` or
// `PageFrame` override was needed. `docs/research/starlight-and-stack.md:32`
// flagged `PageFrame` overrides as "significant complexity"; we never reached
// for one. But note what that cost: `hero` in frontmatter is NOT used, because
// the harvested hub is an editorial single column, not a hero + card grid, and
// Starlight's `hero` shape can't express it. So #4's claim half-survives.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Hub from '../components/Hub.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Coaching hub',
    description: 'Publicly available coaching content — talks and workshops on working with AI.',
    template: 'splash',
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <div class="pfull">
    <Hub stack="starlight" />
  </div>
</StarlightPage>
