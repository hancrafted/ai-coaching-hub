{
  "name": "ai-coaching-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "knip": "knip",
    "prepare": "husky",
    "verify": "archgate check && eslint . && prettier --check . && tsc --noEmit && vitest run && knip",
    "verify:commit": "lint-staged && archgate check && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hancrafted/markdown-harness": "^0.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "archgate": "^0.55.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
