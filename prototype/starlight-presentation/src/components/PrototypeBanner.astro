---
// Parameterised for prototype 2. It previously hardcoded the `map/10-llm-wiki`
// blob URL and `TALK.sourcePath`, so it could only ever describe module 1.
interface Props {
  repo?: string;
  path?: string;
  branch?: string;
  note?: string;
  /** Module 1 only — the governed-markdown control page. */
  controlSlug?: string;
  showVariantHelp?: boolean;
}
const {
  repo,
  path,
  branch = 'map/10-llm-wiki',
  note,
  controlSlug,
  showVariantHelp = false,
} = Astro.props;

const repoFile = repo && path ? `https://github.com/${repo}/blob/${branch}/${path}` : undefined;
// Must go through BASE_URL: under GitHub Pages this site lives at /ai-coaching-hub/.
// `new URL()` is no help here — BASE_URL is a path, not an absolute URL.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const controlPage = controlSlug ? `${base}/${controlSlug}/` : undefined;
---

<aside class="pbanner">
  <p class="pbanner__tag">Prototype — throwaway</p>
  {
    showVariantHelp ? (
      <p class="pbanner__text">
        Three structurally different ways to render one talk. Cycle them with the bar at the bottom,
        the <kbd>&#8592;</kbd> / <kbd>&#8594;</kbd> keys, or <code>?variant=A|B|C</code>. The content
        is identical in all three — only the layout, the information hierarchy and the table of
        contents change.
      </p>
    ) : (
      note && <p class="pbanner__text">{note}</p>
    )
  }
  <p class="pbanner__links">
    {repoFile && (
      <a href={repoFile}>Source: <code>{path}</code></a>
    )}
    {repoFile && controlPage && <span aria-hidden="true">·</span>}
    {controlPage && (
      <a href={controlPage}>Control: the governed file rendered as-is, no design work</a>
    )}
  </p>
</aside>
