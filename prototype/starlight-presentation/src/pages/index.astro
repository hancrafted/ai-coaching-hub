---
// THROWAWAY PROTOTYPE — sub-shape B (a new route), because this repo has no
// existing page for the variants to sit inside; there is no site yet at all.
//
// Three variants of the talk page on this one route, switchable via
// `?variant=A|B|C`. Wrapped in <StarlightPage> so the variants are judged
// against real Starlight chrome — header, search, theme toggle — rather than in
// a vacuum. `template: splash` drops the sidebar and Starlight's own TOC so each
// variant can own its full canvas, including its own table of contents.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PrototypeBanner from '../components/PrototypeBanner.astro';
import VariantAScript from '../components/VariantAScript.astro';
import VariantBRunOfShow from '../components/VariantBRunOfShow.astro';
import VariantCArgument from '../components/VariantCArgument.astro';
import VariantSwitcher from '../components/VariantSwitcher.astro';
import { TALK } from '../talk';

const VARIANTS = [
  { key: 'A', name: 'Script', purpose: 'Read the talk top to bottom' },
  { key: 'B', name: 'Run of show', purpose: 'Drive it on the day — and know what to cut' },
  { key: 'C', name: 'Argument', purpose: 'Trace every claim to its source' },
];
---

<StarlightPage
  frontmatter={{
    title: TALK.title,
    description: TALK.description,
    template: 'splash',
    tableOfContents: false,
    // Three variants on one route would be indexed three times over.
    pagefind: false,
  }}
  hasSidebar={false}
>
  <div class="pfull">
    <PrototypeBanner />

    <div data-variant-panel="A">
      <VariantAScript />
    </div>
    <div data-variant-panel="B" hidden>
      <VariantBRunOfShow />
    </div>
    <div data-variant-panel="C" hidden>
      <VariantCArgument />
    </div>

    <VariantSwitcher variants={VARIANTS} />
  </div>
</StarlightPage>
